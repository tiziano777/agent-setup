{
  "permissions": {
    "allow": [
      "Bash(rtk *)",
      "Mcp:code-review-graph",
      "WebSearch"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk run -- $COMMAND"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "code-review-graph",
        "serve"
      ],
      "type": "stdio"
    }
  }
}